{
  "expo": {
    "name": "JKSS Fund",
    "slug": "jkss-fund",
    "version": "2.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "jkssfund",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jkssfund.app"
    },
    "android": {
      "package": "com.jkssfund.app",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE", "USE_BIOMETRIC", "USE_FINGERPRINT"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      }
    },
    "extra": {
      "apiUrl": "https://your-backend-url.com/api",
      "googleWebClientId": "YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"
    },
    "plugins": ["expo-local-authentication", "expo-secure-store"]
  }
}
