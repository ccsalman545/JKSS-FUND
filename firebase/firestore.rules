rules_version = '2';

// JKSS-FUND v3.5 — least-privilege Firestore rules (paise-exact).
//
// LANGUAGE CONSTRAINTS (verified against the production rules compiler):
//  * NO lambda/filter/map over collections; NO if-statements (a function
//    body is `let` bindings + ONE final return expression; conditionals
//    are ternaries and &&/|| short-circuits).
//  * NO string indexOf/startsWith; NO sum(); NO bare round (math.round);
//    NO 'number' type (int/float only).
//  * A field access on a missing field evaluates to an UNDEFINED value
//    that PROPAGATES (denies the rule) through every operator — including
//    `is` (a call with an UNDEFINED argument yields UNDEFINED). There is
//    NO safe "does field exist" probe: guard by structure instead (the
//    app always writes the fields the rules read; a missing one = deny).
//  * get()/getAfter() take an UNQUOTED PATH EXPRESSION:
//        get(/databases/$(database)/documents/users/$(email))
//    A QUOTED string literal ('/databases/...') is just a string and
//    produces "Received: get(string). Expected: get(path)." at runtime.
//    $(...) captures accept expressions (verified: match-block wildcards,
//    function parameters, let bindings). Build dynamic IDs in a `let`
//    first, then capture it.
//  * request.writes DOES NOT EXIST in Firestore rules. Cross-write
//    consistency of an atomic batch is proved with:
//      - get()      = pre-batch state
//      - getAfter() = FINAL post-batch state (sees every write in the batch)
//    plus canonical (deterministic) document IDs so each write can be
//    addressed exactly, and pre-existence checks (exists(path) == false)
//    so a document "created" by the batch is genuinely new — not a replay.
//  * A request (including every write in a batch) shares a budget of 1000
//    expression evaluations, so helpers stay small and checks are ordered
//    to short-circuit cheaply.
//
// ADMIN TRUST ROOT: a users/{email} doc with role 'admin'. Role is created
// only (by an admin or the console, at create-time) and can never be
// updated, so the admin set can only grow through the two create rules.
//
// STUDENT ACCESS GATE (held legacy accounts): a student's financial paths
// (own profile read/write, own ledger read, withdrawals, committee read)
// require a USERNAME identifier (<username>@students.jkss-fund.invalid) or an
// explicit legacyAuthorizations/{email} document with authorized == true.
// Any other real-email account is on hold and reads/writes nothing financial.
// Admins are unchanged.
//
// STUDENT PRE-AUTHORIZATION: profile documents are created ONLY by admins
// (or the console). There is NO self-provisioning path — a signed-in
// account without a matching users/{email} doc has no profile and the app
// keeps it out of the student dashboard.
//
// CANONICAL IDS (replay/ledger integrity):
//  * earning txn:    earn_{jobId}_{email}        (rule-reconstructed —
//  * reversal txn:   rev_{jobId}_{email}         string-only, no engine
//                                                  toString() needed)
//  * withdrawal txn: w_{email}_{txnSeq}          (CLIENT-supplied id; the
//    where txnSeq is the per-user monotonically increasing counter on the
//    user doc (0 for legacy docs, bumped by exactly 1 in the withdrawal
//    user write). This engine has NO int->string conversion, so the pair
//    is a BIDIRECTIONAL lock instead: the user write carries
//    withdrawalTxnId (the txn's id) and the txn carries seq (the int);
//    each side verifies the other — no id can be detached from its
//    balance write, and no balance write can skip its ledger entry.)
//
// BATCH PROTOCOL (what the app sends, what the rules prove):
//   withdrawal (self, 2 writes):
//     users/{me} update  {balancePaise, balance, txnSeq: oldSeq+1,
//                         withdrawalTxnId: 'w_{me}_{oldSeq+1}'}
//     users/{me}/transactions/w_{me}_{oldSeq+1} set (withdrawal, seq: N)
//     - user rule: final >= 0, delta > 0, seq bumped by exactly 1, and
//       the referenced txn is NEW in the batch (exists: absent /
//       getAfter: present) with type 'withdrawal' and seq == newSeq.
//     - txn rule: final user balance (getAfter) == pre-balance - amount,
//       final >= 0, post-batch user doc references this txn id, and
//       t.seq == post-batch user seq (bidirectional companion lock).
//   job credit (admin):
//     jobs/{id} set (shape-validated, allocations map {email: paise})
//     users/{e} update  {balancePaise, balance, creditJobId: id}
//     users/{e}/transactions/earn_{id}_{e} set
//     meta/committee update {balancePaise, balance, lastJobId: id}
//     - user rule: the job and the canonical earning txn must be NEW in the
//       batch (get: absent / getAfter: present), and the credit delta must
//       equal the job's stored allocation for this student.
//     - committee rule: the job must be NEW in the batch and the committee
//       delta must equal exactly the job's 10% committee share.
//   job reversal (admin):
//     jobs/{id} update -> {status: 'reversed', reversedAt} (tombstone,
//     never a delete — the original allocation history stays auditable)
//     users/{e} update  {balancePaise, balance, reversalJobId: id}
//     users/{e}/transactions/rev_{id}_{e} set
//     meta/committee update {balancePaise, balance, reversedJobId: id}
//     - user rule: the debit must equal the ORIGINAL stored allocation
//       (pre-batch job doc — immune to the status-only update in the batch);
//       removed students may end negative, active students may not.
//     - committee rule: the committee must be credited back by exactly the
//       ORIGINAL committee share.
//   A batch is all-or-nothing, so every committed batch is fully consistent;
//   replayed batches fail on the "new in batch" checks or on zero deltas.
//
// MONEY MODEL:
//  - Integer PAISE (balancePaise / amountPaise) is authoritative; the
//    rupee floats are display mirrors, never used in checks.
//  - Jobs store 10% committee (floored paise) / 90% students exactly;
//    allocations are a MAP {email: amountPaise}, every value `base` or
//    `base+1` (base = studentSharePaise / studentCount).
//  - Balances are written as EXPLICIT FINAL VALUES (never server
//    increments): rules compute deltas against the live (pre-batch)
//    document, which is what makes replays and double-spends impossible.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------ helpers ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    // ADMIN LOOKUP (engine-verified pattern, diag run 38702395701):
    //  - get()/getAfter() return a wrapper whose .data holds the doc fields
    //    (a direct .exists member DOES NOT exist in this engine version —
    //    it errors "Property exists is undefined on object").
    //  - existence is tested with exists(path), which returns a clean bool.
    //  - a read of .data on a missing doc errors (denies) — always gate
    //    with exists() first via && short-circuit when absence is legal.
    function adminDocRole(email) {
      return exists(/databases/$(database)/documents/users/$(email))
        && get(/databases/$(database)/documents/users/$(email)).data.role == 'admin';
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && adminDocRole(request.auth.token.email);
    }

    function isSelf(email) {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email == email;
    }

    /* ----------------- student access gate (held legacy accounts) -------
       A signed-in account may use ANY student financial path only when:
         (1) its Auth email is a USERNAME identifier
             (<username>@students.jkss-fund.invalid — the v3.0 login); or
         (2) an explicit authorization exists at
             legacyAuthorizations/{email} with authorized == true (written
             only by an admin in the Firebase console / admin SDK).
       Any other real-email account is a legacy student ON HOLD (Option B):
       it reads and writes no financial data, even when its users/{email}
       profile still exists with a balance and a txnSeq. Admins keep their
       access through isAdmin() and selfAccessOk(); nothing here changes
       what an admin can do.
       This is a rules-level freeze. The provisioning tool's txnSeq freeze
       (decision D-1) is a separate, tool-level control.                  */
    function usernameIdentifier(e) {
      return e.matches('^[a-z0-9._-]+@students[.]jkss-fund[.]invalid$');
    }

    function legacyAuthorized(e) {
      return exists(/databases/$(database)/documents/legacyAuthorizations/$(e))
        && get(/databases/$(database)/documents/legacyAuthorizations/$(e)).data.authorized == true;
    }

    function studentAccessOk() {
      return signedIn()
        && request.auth.token.email is string
        && (usernameIdentifier(request.auth.token.email)
            || legacyAuthorized(request.auth.token.email));
    }

    // Self paths: an authorized student, or an admin (admin self-access is
    // unchanged by the gate).
    function selfAccessOk() {
      return studentAccessOk() || isAdmin();
    }

    // Integer paise of a user/committee doc (legacy docs carry rupee floats).
    function paiseOf(d) {
      return d.balancePaise is int ? d.balancePaise : math.round(d.balance * 100);
    }

    // NOTE: a field access on a MISSING field evaluates to an UNDEFINED
    // value that propagates (denies the rule) through every operator.
    // The app therefore ALWAYS writes creditJobId/reversalJobId (one of
    // them null) and txnSeq on every financial user write — a null value
    // is readable, a missing one is not.

    /* ------------------------------- /users ----------------------------- */

    match /users/{email} {

      function selfProfileOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['full_name', 'avatar', 'lastActiveAt']);
      }

      // Self withdrawal: final >= 0, positive delta, ONLY the balance
      // fields + seq bump + the companion txn reference, seq advanced by
      // exactly 1, and the referenced txn must be NEW in this batch with
      // seq == newSeq. (Checked AFTER selfProfileOk so profile updates
      // never touch these reads.)
      // The pair is a BIDIRECTIONAL lock (no int->string exists in this
      // engine, so the txn ID is client-supplied and verified from both
      // sides): the user write names the txn (withdrawalTxnId) and the
      // txn carries the seq (t.seq); each side checks the other.
      function withdrawalOk() {
        let newPaise = request.resource.data.balancePaise;
        let newSeq = request.resource.data.txnSeq;
        let oldSeq = resource.data.txnSeq;
        let delta = paiseOf(resource.data) - newPaise;
        let tid = request.resource.data.withdrawalTxnId is string ? request.resource.data.withdrawalTxnId : null;
        let tAfter = tid == null ? null : getAfter(/databases/$(database)/documents/users/$(email)/transactions/$(tid));
        return newPaise is int
          && newPaise >= 0
          && oldSeq is int
          && newSeq is int
          && newSeq == oldSeq + 1
          && delta > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['balance', 'balancePaise', 'txnSeq', 'withdrawalTxnId'])
          && tid != null
          && exists(/databases/$(database)/documents/users/$(email)/transactions/$(tid)) == false
          && tAfter != null
          && tAfter.data.type == 'withdrawal'
          && tAfter.data.seq == newSeq;
      }

      // Admin job credit: the user write carries creditJobId; the job and
      // the canonical earning txn must be NEW in this batch, and the credit
      // delta must equal the job's stored allocation for this student.
      function jobCreditOk() {
        let newPaise = request.resource.data.balancePaise;
        let jid = request.resource.data.creditJobId;
        let delta = newPaise - paiseOf(resource.data);
        let tid = jid is string ? 'earn_' + jid + '_' + email : null;
        let jAfter = jid is string ? getAfter(/databases/$(database)/documents/jobs/$(jid)) : null;
        let tAfter = tid == null ? null : getAfter(/databases/$(database)/documents/users/$(email)/transactions/$(tid));
        let tData = (tAfter != null) ? tAfter.data : null;
        return newPaise is int
          && newPaise >= 0
          && jid is string
          && delta > 0
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['balance', 'balancePaise', 'creditJobId', 'reversalJobId'])
          && exists(/databases/$(database)/documents/jobs/$(jid)) == false
          && jAfter != null
          && jAfter.data.allocations is map
          && jAfter.data.allocations.get(email, null) is int
          && jAfter.data.allocations.get(email, null) == delta
          && exists(/databases/$(database)/documents/users/$(email)/transactions/$(tid)) == false
          && tData != null
          && tData.type == 'earning'
          && tData.studentId == email
          && tData.jobId == jid
          && tData.amountPaise == delta;
      }

      // Admin job reversal: debit equals the ORIGINAL stored allocation
      // (pre-batch job doc — immune to the status-only update in the batch);
      // the rev txn must be NEW in the batch; removed students may end
      // negative (standing liability), active students may not.
      function jobReversalOk() {
        let newPaise = request.resource.data.balancePaise;
        let jid = request.resource.data.reversalJobId;
        let delta = paiseOf(resource.data) - newPaise;
        let tid = jid is string ? 'rev_' + jid + '_' + email : null;
        let j = jid is string ? get(/databases/$(database)/documents/jobs/$(jid)) : null;
        let jAfter = jid is string ? getAfter(/databases/$(database)/documents/jobs/$(jid)) : null;
        let tAfter = tid == null ? null : getAfter(/databases/$(database)/documents/users/$(email)/transactions/$(tid));
        let tData = (tAfter != null) ? tAfter.data : null;
        return newPaise is int
          && delta > 0
          && jid is string
          && !(newPaise < 0 && resource.data.removedAt == null)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['balance', 'balancePaise', 'creditJobId', 'reversalJobId'])
          && exists(/databases/$(database)/documents/jobs/$(jid))
          && j != null
          && j.data.status == 'active'
          && jAfter != null
          && jAfter.data.status == 'reversed'
          && j.data.allocations is map
          && j.data.allocations.get(email, null) is int
          && j.data.allocations.get(email, null) == delta
          && exists(/databases/$(database)/documents/users/$(email)/transactions/$(tid)) == false
          && tData != null
          && tData.type == 'reversal'
          && tData.studentId == email
          && tData.jobId == jid
          && tData.amountPaise == delta;
      }

      function adminMaintenanceOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['full_name', 'avatar', 'lastActiveAt', 'removedAt']);
      }

      // New profile (first sign-in or admin pre-registration). txnSeq is
      // the per-user withdrawal counter, always initialized to 0.
      function newProfileOk(role) {
        let d = request.resource.data;
        return d.email == email
          && d.role == role
          && d.balancePaise == 0
          && d.balance == 0
          && d.txnSeq == 0
          && d.keys().hasOnly(['email', 'role', 'full_name', 'avatar',
                                'balancePaise', 'balance', 'txnSeq', 'createdAt']);
      }

      allow get: if isAdmin() || (isSelf(email) && selfAccessOk());
      allow list: if isAdmin();

      /* Students are PRE-AUTHORIZED: only an admin (or the Firebase
         console) may create a user profile, always at zero balance with
         the known safe fields. A Google sign-in whose email has no
         matching profile document is simply signed in without a profile
         — the app then shows a "not pre-authorized" state and never
         opens the student dashboard. Self-provisioning is impossible:
         no rule grants a student the right to create her own doc. */
      allow create: if isAdmin() && (newProfileOk('student') || newProfileOk('admin'));

      // Self: atomic withdrawal pair (user + canonical txn), or profile.
      // Profile is checked first so profile updates never reach the
      // withdrawal reads (a missing optional field would otherwise deny).
      allow update: if isSelf(email) && selfAccessOk() && (selfProfileOk() || withdrawalOk());

      // Admin: plain roster maintenance first, then the verified batch
      // roles (each reads optional fields, so they must not run for
      // maintenance writes).
      allow update: if isAdmin() && (adminMaintenanceOk() || jobCreditOk() || jobReversalOk());

      // Hard delete is denied for everyone: removal is a tombstone update
      // (removedAt) so historical allocations remain reversible.
      allow delete: if false;
    }

    /* ----------------- /users/{email}/transactions ---------------------- */

    match /users/{email}/transactions/{txnId} {

      allow get: if isAdmin() || (isSelf(email) && selfAccessOk());
      allow list: if isAdmin() || (isSelf(email) && selfAccessOk());

      // Withdrawal txn: the FINAL user state after this batch must equal
      // the pre-balance minus exactly this amount (>= 0), the post-batch
      // user doc must reference THIS txn id (withdrawalTxnId == txnId),
      // and t.seq must equal the post-batch user seq — the bidirectional
      // companion lock (no int->string in this engine, so the ID is
      // verified from both sides instead of reconstructed).
      function withdrawalTxnOk() {
        let t = request.resource.data;
        let u = get(/databases/$(database)/documents/users/$(email));
        let uAfter = getAfter(/databases/$(database)/documents/users/$(email));
        let finalPaise = uAfter.data.balancePaise;
        return t.type == 'withdrawal'
          && t.studentId == email
          && t.amountPaise is int
          && t.amountPaise > 0
          && t.amount != null
          && t.amount > 0
          && t.seq is int
          && exists(/databases/$(database)/documents/users/$(email))
          && finalPaise is int
          && finalPaise >= 0
          && finalPaise == paiseOf(u.data) - t.amountPaise
          && uAfter.data.withdrawalTxnId == txnId
          && t.seq == uAfter.data.txnSeq;
      }

      // Earning txn: canonical ID; the job must be NEW in this batch
      // (get: absent / getAfter: present) and store this student's
      // allocation at exactly this amount.
      function earningTxnOk() {
        let t = request.resource.data;
        let jid = t.jobId is string ? t.jobId : null;
        let jAfter = jid == null ? null : getAfter(/databases/$(database)/documents/jobs/$(jid));
        let a = (jAfter != null && jAfter.data.allocations is map) ? jAfter.data.allocations.get(email, null) : null;
        return t.type == 'earning'
          && t.studentId == email
          && jid != null
          && t.amountPaise is int
          && t.amountPaise > 0
          && txnId == 'earn_' + jid + '_' + email
          && exists(/databases/$(database)/documents/jobs/$(jid)) == false
          && a is int
          && a == t.amountPaise;
      }

      // Reversal txn: canonical ID; the ORIGINAL (pre-batch) job must
      // store this student's allocation at exactly this amount, and the
      // job must be tombstoned within this same batch.
      function reversalTxnOk() {
        let t = request.resource.data;
        let jid = t.jobId is string ? t.jobId : null;
        let j = jid == null ? null : get(/databases/$(database)/documents/jobs/$(jid));
        let jAfter = jid == null ? null : getAfter(/databases/$(database)/documents/jobs/$(jid));
        let a = (j != null && j.data.allocations is map) ? j.data.allocations.get(email, null) : null;
        return t.type == 'reversal'
          && t.studentId == email
          && jid != null
          && t.amountPaise is int
          && t.amountPaise > 0
          && txnId == 'rev_' + jid + '_' + email
          && j != null
          && j.data.status == 'active'
          && jAfter != null
          && jAfter.data.status == 'reversed'
          && a is int
          && a == t.amountPaise;
      }

      // Ledger entries are immutable: only the three verified creations.
      allow create: if (isSelf(email) && selfAccessOk() && withdrawalTxnOk())
                   || (isAdmin() && (earningTxnOk() || reversalTxnOk()));

      allow update: if false;
      allow delete: if false;
    }

    /* ------------------------------- /jobs ------------------------------ */

    match /jobs/{jobId} {

      allow get: if isAdmin();
      allow list: if isAdmin();

      // Structural validity of a new job. committee = amount/10 floored to
      // whole paise; students get the exact remainder. Every allocation
      // value must be `base` or `base+1` (base = pool / n, integer
      // division), bounding the allocation sum within n paise of the pool;
      // the app's largest-remainder builder is exact.
      function jobShapeOk(d) {
        let pool = d.studentSharePaise is int ? d.studentSharePaise : 0;
        let n = d.studentCount is int ? d.studentCount : 0;
        let base = n > 0 ? pool / n : 0;
        return d.name is string
          && d.name != ''
          && d.name.size() <= 120
          && d.date is string
          && d.date != ''
          && d.amountPaise is int
          && d.amountPaise > 0
          && n > 0
          && d.committeeSharePaise is int
          && d.committeeSharePaise == d.amountPaise / 10
          && pool > 0
          && pool == d.amountPaise - d.committeeSharePaise
          && d.allocations is map
          && d.allocations.size() == n
          && d.allocations.values().hasOnly([base, base + 1]);
      }

      // The committee must be credited by EXACTLY the job's share within
      // this same batch (final state via getAfter — a batch without the
      // committee write shows delta 0 and is rejected).
      function jobCommitteeCredited(d) {
        let cOld = get(/databases/$(database)/documents/meta/committee);
        let cAfter = getAfter(/databases/$(database)/documents/meta/committee);
        return cOld != null
          && cAfter != null
          && cAfter.data.balancePaise is int
          && cAfter.data.balancePaise >= 0
          && cAfter.data.balancePaise - paiseOf(cOld.data) == d.committeeSharePaise;
      }

      allow create: if isAdmin()
        && jobShapeOk(request.resource.data)
        && jobCommitteeCredited(request.resource.data);

      // Status flag toggling (active/archived) — the only plain update.
      // The status must actually CHANGE (an identical no-op write — e.g. a
      // replayed batch — has an empty diff and would otherwise pass).
      function statusToggleOk() {
        return request.resource.data.status != resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
          && request.resource.data.status in ['active', 'archived'];
      }

      // Reversal = tombstone (status 'reversed' + reversedAt), never a
      // delete: the original allocation history stays readable for audit.
      function reversalJobOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.allocations is map
          && resource.data.allocations.size() > 0
          && resource.data.committeeSharePaise is int
          && resource.data.status != 'reversed'
          && request.resource.data.status == 'reversed'
          && changed.hasOnly(['status', 'reversedAt']);
      }

      // The committee must be credited back by EXACTLY the original share
      // within this same batch.
      function reversalCommitteeReturned() {
        let cOld = get(/databases/$(database)/documents/meta/committee);
        let cAfter = getAfter(/databases/$(database)/documents/meta/committee);
        return cOld != null
          && cAfter != null
          && cAfter.data.balancePaise is int
          && cAfter.data.balancePaise >= 0
          && paiseOf(cOld.data) - cAfter.data.balancePaise == resource.data.committeeSharePaise;
      }

      allow update: if isAdmin() && (statusToggleOk()
        || (reversalJobOk() && reversalCommitteeReturned()));

      // Jobs are never deleted (audit history). Use the reversal tombstone.
      allow delete: if false;
    }

    /* --------------------------- /meta/committee ------------------------ */

    match /meta/committee {
      // The committee balance is shown to authorized students (username
      // identifiers, or explicitly authorized legacy accounts) and admins.
      // A legacy account on hold cannot read the fund total.
      allow get: if studentAccessOk() || isAdmin();
      allow list: if false;

      // Bootstrap at zero only (idempotent app init).
      allow create: if (studentAccessOk() || isAdmin())
        && request.resource.data.balancePaise == 0
        && request.resource.data.balance == 0
        && request.resource.data.keys().hasOnly(['balancePaise', 'balance']);

      // Credit: the referenced job must be NEW in this batch (created by
      // it) and the committee delta must equal exactly the job's share.
      function creditOk() {
        let c = request.resource.data;
        let jid = c.lastJobId is string ? c.lastJobId : null;
        let jAfter = jid == null ? null : getAfter(/databases/$(database)/documents/jobs/$(jid));
        let cOld = get(/databases/$(database)/documents/meta/committee);
        return jid != null
          && exists(/databases/$(database)/documents/jobs/$(jid)) == false
          && jAfter != null
          && jAfter.data.amountPaise is int
          && jAfter.data.committeeSharePaise is int
          && jAfter.data.committeeSharePaise == jAfter.data.amountPaise / 10
          && cOld != null
          && c.balancePaise is int
          && c.balancePaise >= 0
          && c.balancePaise - paiseOf(cOld.data) == jAfter.data.committeeSharePaise;
      }

      // Reversal credit-back: the referenced job exists (pre-batch) and the
      // committee must drop by exactly its ORIGINAL share, staying >= 0.
      function reversalCreditOk() {
        let c = request.resource.data;
        let jid = c.reversedJobId is string ? c.reversedJobId : null;
        let j = jid == null ? null : get(/databases/$(database)/documents/jobs/$(jid));
        let jAfter = jid == null ? null : getAfter(/databases/$(database)/documents/jobs/$(jid));
        let cOld = get(/databases/$(database)/documents/meta/committee);
        return jid != null
          && exists(/databases/$(database)/documents/jobs/$(jid))
          && j != null
          && j.data.status == 'active'
          && jAfter != null
          && jAfter.data.status == 'reversed'
          && j.data.amountPaise is int
          && j.data.committeeSharePaise is int
          && cOld != null
          && c.balancePaise is int
          && c.balancePaise >= 0
          && paiseOf(cOld.data) - c.balancePaise == j.data.committeeSharePaise;
      }

      allow update: if isAdmin() && (creditOk() || reversalCreditOk());

      allow delete: if false;
    }

    /* ------------------ legacy real-email authorizations ---------------- */

    // The explicit "otherwise authorized" route for a legacy real-email
    // student (Option B). A document here lets that account use the student
    // paths above, but ONLY when its authorized field is true. Created,
    // changed or deleted ONLY by an admin in the Firebase console or an
    // admin SDK script (both bypass rules). Clients can never write it, and
    // only admins can read it.
    match /legacyAuthorizations/{email} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /* -------------------- legacy /transactions (audit) ------------------ */

    // Pre-v3.1 top-level transaction collection. Reads are admin-only
    // (audit); writes are hard-denied so the historical ledger is immutable.
    match /transactions/{txnId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Explicit deny for everything not covered above (no catch-alls).
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
