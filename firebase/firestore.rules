rules_version = '2';

// DIAGNOSTIC RUN — which get() path-expression pattern resolves?
// Each diag/{k} read succeeds iff pattern k evaluates true for an
// authenticated admin with the seeded users/admin@jkss.in doc.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // D1: wildcard passed as a function PARAMETER + email parameter
    function d1(db, email) {
      let d = get(/databases/$(db)/documents/users/$(email));
      return d.exists && d.data.role == 'admin';
    }

    // D2: wildcard via function SCOPE + inline auth expression
    function d2() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.token.email));
      return d.exists && d.data.role == 'admin';
    }

    // D4: wildcard as a parameter only (single capture)
    function d4(db) {
      let d = get(/databases/$(db)/documents/meta/committee);
      return d.exists && d.data.balancePaise is int;
    }

    // D5: CURRENT (failing) pattern — wildcard via scope, email parameter
    function d5(email) {
      let d = get(/databases/$(database)/documents/users/$(email));
      return d.exists && d.data.role == 'admin';
    }

    match /users/{email} {
      allow get: if false;
    }

    match /meta/committee {
      allow get: if false;
    }

    match /diag/{k} {
      // D3 is the official-docs pattern, inlined in the rule itself.
      allow get: if signedIn()
        && (
          (k == 'd1' && d1(database, 'admin@jkss.in'))
          || (k == 'd2' && d2())
          || (k == 'd3' && get(/databases/$(database)/documents/users/$(request.auth.token.email)).exists)
          || (k == 'd4' && d4(database))
          || (k == 'd5' && d5('admin@jkss.in'))
        );
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
