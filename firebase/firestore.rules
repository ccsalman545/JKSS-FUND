rules_version = '2';

// DIAGNOSTIC ROUND 2 — what does get() actually return in this engine?
// Seeded: meta/committee = {balancePaise: 1000, balance: 10}.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{email} {
      allow get: if false;
    }

    match /meta/committee {
      allow get: if false;
    }

    match /diag/{k} {
      allow get: if signedIn()
        && (
          (k == 'e1' && (get(/databases/$(database)/documents/meta/committee) is map))
          || (k == 'e2' && (get(/databases/$(database)/documents/meta/committee) is int))
          || (k == 'e3' && (get(/databases/$(database)/documents/meta/committee) is string))
          || (k == 'e4' && (get(/databases/$(database)/documents/meta/committee) is bool))
          || (k == 'e5' && (get(/databases/$(database)/documents/meta/committee) is null))
          || (k == 'e6' && (get(/databases/$(database)/documents/meta/committee) != null))
          || (k == 'e7' && (get(/databases/$(database)/documents/meta/committee).data.balancePaise is int))
          || (k == 'e8' && (get(/databases/$(database)/documents/meta/committee).balancePaise is int))
          || (k == 'e9' && exists(/databases/$(database)/documents/meta/committee))
          || (k == 'e10' && (get(/databases/$(database)/documents/meta/committee).data is map))
        );
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
