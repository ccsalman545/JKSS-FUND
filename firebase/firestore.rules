rules_version = '2';

// JKSS-FUND v3.4 — least-privilege Firestore rules (paise-exact).
//
// LANGUAGE CONSTRAINTS (verified against the production rules compiler):
//  * NO lambda/filter/map over collections; NO if-statements (a function
//    body is `let` bindings + ONE final return expression; conditionals
//    are ternaries and &&/|| short-circuits).
//  * NO string indexOf/startsWith; NO sum(); NO bare round (math.round);
//    NO 'number' type (int/float only).
//  * map[key] on a missing key is an ERROR — use map.get(key, default)
//    or guard with an `is` check first.
//  * get()/getAfter() take a PATH TEMPLATE whose $(...) captures may ONLY
//    be simple variable references (wildcards, function parameters, let
//    bindings) — a complex expression like $(request.auth.token.email)
//    evaluates to a plain string and get() rejects it at runtime.
//  * A request (including every write in an atomic batch) shares a budget
//    of 1000 expression evaluations, so helpers stay small and checks are
//    ordered to short-circuit cheaply.
//
// ADMIN TRUST ROOT (two tiers, no escalation possible either way):
//  1. Fast path: the `admin` custom auth claim (granted once, out of
//     band, via the Firebase console or Admin SDK).
//  2. Fallback: a users/{email} doc with role 'admin'. Role is created
//     only (by an admin or the console) and can never be updated, so the
//     admin set can only grow through the two create rules below.
//
// BATCH PROTOCOL (what the app sends, what the rules prove):
//   withdrawal (self, exactly 2 writes):
//     users/{me} update            +  users/{me}/transactions/{any} set
//   job credit (admin):
//     jobs/{id} set                +  users/{e} update (per non-zero alloc)
//     users/{e}/transactions/earn_{id}_{e} set (per non-zero alloc)
//     meta/committee update        (carries lastJobId = id)
//   job reversal (admin):
//     jobs/{id} update -> status 'reversed' + reversedAt   (tombstone,
//     never a delete — the original allocation history stays auditable)
//     users/{e} update (per ORIGINAL allocation)
//     users/{e}/transactions/rev_{id}_{e} set
//     meta/committee update        (carries reversedJobId = id)
//
// The committee write at the EXACT key /meta/committee is the batch's job
// reference: any rule in the batch can read its lastJobId / reversedJobId
// field and address the job write and canonical txn keys without iterating
// over unknown paths. Per-write checks (each student's delta equals their
// stored allocation; the canonical txn amount equals the same delta) plus
// the job-level getAfter() committee checks make every committed batch
// financially consistent; a batch is all-or-nothing, so there is no
// partially applied state.
//
// MONEY MODEL:
//   - Integer PAISE (balancePaise / amountPaise) is authoritative; the
//     rupee floats are display mirrors, never used in checks.
//   - Jobs store 10% committee (floored paise) / 90% students exactly;
//     allocations are a MAP {email: amountPaise}, every value `base` or
//     `base+1` (base = studentSharePaise / studentCount).
//   - Balances are written as EXPLICIT FINAL VALUES (never server
//     increments): rules compute deltas against the live document, so a
//     stale/duplicate/double-spend write is rejected.
//   - User docs must carry an integer balancePaise (migrate legacy
//     rupee-only docs once before the first job credit); students may
//     never create or modify the `admin` role; removal is a tombstone.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------ helpers ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    // Simple-variable-only path capture: the email arrives as a parameter.
    // (Missing fields evaluate to UNDEFINED: `is` returns false for it,
    //  comparisons propagate it — so every optional read is is-guarded.)
    function adminDocRole(email) {
      let d = get('/databases/$(database)/documents/users/$(email)');
      return d.exists && d.data.role is string && d.data.role == 'admin';
    }

    function isAdmin() {
      return request.auth != null
        && (
          (request.auth.token.admin is bool && request.auth.token.admin == true)
          || (request.auth.token.email is string
              && adminDocRole(request.auth.token.email))
        );
    }

    function isSelf(email) {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email == email;
    }

    // Integer paise of a user/committee doc (legacy docs carry rupee floats).
    function paiseOf(d) {
      return d.balancePaise is int ? d.balancePaise : math.round(d.balance * 100);
    }

    // Only the balance fields may have changed in a financial update.
    function balanceFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['balance', 'balancePaise']);
    }

    function committeeOld() {
      let d = get('/databases/$(database)/documents/meta/committee');
      return d.exists ? d.data : null;
    }

    function committeeNew() {
      let d = getAfter('/databases/$(database)/documents/meta/committee');
      return d.exists ? d.data : null;
    }

    // Original allocation stored on a job (pre-batch read).
    function jobAlloc(jobId, email) {
      let d = get('/databases/$(database)/documents/jobs/$(jobId)');
      let a = d.exists ? d.data.allocations : null;
      return a is map ? a.get(email, null) : null;
    }

    /* ------------------------------- /users ----------------------------- */

    match /users/{email} {

      function selfProfileOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['full_name', 'avatar', 'lastActiveAt']);
      }

      // The batch must be EXACTLY this user update + one txn under
      // users/{me}/transactions, and the final (post-write) paise balance
      // must be non-negative with the txn amount matching the reduction.
      // The delta is computed against the LIVE document, so replaying a
      // stale batch (double spend) yields delta 0 and is rejected.
      function withdrawalBatchOk() {
        let newPaise = request.resource.data.balancePaise;
        let delta = paiseOf(resource.data) - newPaise;
        let other = request.writes.keys().removeAll(['users/' + email]);
        let okKey = other.size() == 1 ? other[0] : '';
        let segs = okKey == '' ? [] : okKey.split('/');
        let tw = okKey == '' ? null : request.writes.get(okKey, null);
        let t = tw == null ? null : tw.resource.data;
        return request.writes.size() == 2
          && newPaise is int
          && newPaise >= 0
          && delta > 0
          && balanceFieldsOnly()
          && segs.size() == 4
          && segs[0] == 'users'
          && segs[1] == email
          && segs[2] == 'transactions'
          && tw != null
          && tw.method == 'set'
          && t != null
          && t.type == 'withdrawal'
          && t.studentId == email
          && t.amountPaise is int
          && t.amountPaise == delta;
      }

      function adminMaintenanceOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['full_name', 'avatar', 'lastActiveAt', 'removedAt']);
      }

      // The credit equals this student's stored allocation in the new job,
      // the canonical earning txn is present, and the committee update in
      // the batch references exactly that job.
      function jobCreditOk() {
        let newPaise = request.resource.data.balancePaise;
        let delta = newPaise - resource.data.balancePaise;
        let c = request.writes.get('meta/committee', null);
        let jobId = (c != null && c.method == 'update' && c.resource.data.lastJobId is string) ? c.resource.data.lastJobId : null;
        let jw = jobId == null ? null : request.writes.get('jobs/' + jobId, null);
        let allocs = (jw != null && jw.method == 'set' && jw.resource.data.allocations is map) ? jw.resource.data.allocations : null;
        let mine = allocs == null ? null : allocs.get(email, null);
        let t = jobId == null ? null : request.writes.get('users/' + email + '/transactions/earn_' + jobId + '_' + email, null);
        let tData = (t != null && t.method == 'set') ? t.resource.data : null;
        return newPaise is int
          && resource.data.balancePaise is int
          && delta > 0
          && balanceFieldsOnly()
          && c != null
          && c.method == 'update'
          && jobId != null
          && jw != null
          && jw.method == 'set'
          && allocs != null
          && mine is int
          && mine == delta
          && tData != null
          && tData.type == 'earning'
          && tData.studentId == email
          && tData.jobId == jobId
          && tData.amountPaise == delta;
      }

      // Debit equals the ORIGINAL stored allocation (pre-batch read —
      // immune to the status-only job update in the same batch). Removed
      // students may end negative (standing liability); active students
      // may not.
      function jobReversalOk() {
        let newPaise = request.resource.data.balancePaise;
        let delta = resource.data.balancePaise - newPaise;
        let c = request.writes.get('meta/committee', null);
        let jobId = (c != null && c.method == 'update' && c.resource.data.reversedJobId is string) ? c.resource.data.reversedJobId : null;
        let jw = jobId == null ? null : request.writes.get('jobs/' + jobId, null);
        let mine = jobId == null ? null : jobAlloc(jobId, email);
        let t = jobId == null ? null : request.writes.get('users/' + email + '/transactions/rev_' + jobId + '_' + email, null);
        let tData = (t != null && t.method == 'set') ? t.resource.data : null;
        return newPaise is int
          && resource.data.balancePaise is int
          && delta > 0
          && !(newPaise < 0 && resource.data.removedAt == null)
          && balanceFieldsOnly()
          && c != null
          && c.method == 'update'
          && jobId != null
          && jw != null
          && jw.method == 'update'
          && mine is int
          && mine == delta
          && tData != null
          && tData.type == 'reversal'
          && tData.studentId == email
          && tData.jobId == jobId
          && tData.amountPaise == delta;
      }

      // New profile (first sign-in or admin pre-registration).
      function newProfileOk(role) {
        let d = request.resource.data;
        return d.email == email
          && d.role == role
          && d.balancePaise == 0
          && d.balance == 0
          && d.keys().hasOnly(['email', 'role', 'full_name', 'avatar',
                                'balancePaise', 'balance', 'createdAt']);
      }

      allow get: if isSelf(email) || isAdmin();

      // Only admins may list students. (The wildcard is unbound during a
      // list; per-document visibility is enforced by the get rule.)
      allow list: if isAdmin();

      /* First sign-in self-provisioning: always student, zero balances,
         only the known safe fields. */
      allow create: if isSelf(email) && newProfileOk('student');

      /* Admins provision students and may grant the admin role on create.
         Granting/modifying an existing user's role is impossible — the
         update rules below never allow role/email/balance changes. */
      allow create: if isAdmin() && (newProfileOk('student') || newProfileOk('admin'));

      // Self: atomic withdrawal pair, or plain profile fields.
      allow update: if isSelf(email) && (withdrawalBatchOk() || selfProfileOk());

      // Admin: the three verified batch roles, cheapest failure first is
      // not possible per-role, but each is cheap to reject when the batch
      // shape doesn't match (committee write missing, etc.).
      allow update: if isAdmin() && (jobCreditOk() || jobReversalOk() || adminMaintenanceOk());

      // Hard delete is denied for everyone: removal is a tombstone update
      // (removedAt) so historical allocations remain reversible.
      allow delete: if false;
    }

    /* ----------------- /users/{email}/transactions ---------------------- */

    match /users/{email}/transactions/{txnId} {

      allow get: if isSelf(email) || isAdmin();
      allow list: if isSelf(email) || isAdmin();

      // Withdrawal txn shape. The amount==live-delta and non-negative
      // final-balance guarantees live on the companion users/{email}
      // update (withdrawalBatchOk) — both writes are in one atomic batch,
      // so the pair is consistent or the whole batch is rejected.
      function withdrawalTxnShapeOk() {
        let t = request.resource.data;
        return request.writes.size() == 2
          && t.type == 'withdrawal'
          && t.studentId == email
          && t.amountPaise is int
          && t.amountPaise > 0
          && t.amount != null
          && t.amount > 0;
      }

      // Job txn shape with the canonical ID (earn_{jobId}_{email} or
      // rev_{jobId}_{email}). The per-student amount==allocation proof is
      // enforced on the companion users/{email} update in the same batch.
      function jobTxnShapeOk() {
        let t = request.resource.data;
        let jid = t.jobId is string ? t.jobId : null;
        return jid != null
          && t.studentId == email
          && t.amountPaise is int
          && t.amountPaise > 0
          && ((t.type == 'earning' && txnId == 'earn_' + jid + '_' + email)
              || (t.type == 'reversal' && txnId == 'rev_' + jid + '_' + email));
      }

      // Ledger entries are immutable: only the verified creations.
      allow create: if (isSelf(email) && withdrawalTxnShapeOk())
                   || (isAdmin() && jobTxnShapeOk());

      allow update: if false;
      allow delete: if false;
    }

    /* ------------------------------- /jobs ------------------------------ */

    match /jobs/{jobId} {

      allow get: if isAdmin();
      allow list: if isAdmin();

      // Structural validity of a new job. committee = amount/10 floored to
      // whole paise; students get the exact remainder. Every allocation
      // value must be `base` or `base+1` (base = pool / n, integer
      // division), bounding the allocation sum within n paise of the pool;
      // the app's largest-remainder builder is exact.
      function jobShapeOk(d) {
        let pool = d.studentSharePaise is int ? d.studentSharePaise : 0;
        let n = d.studentCount is int ? d.studentCount : 0;
        let base = n > 0 ? pool / n : 0;
        return d.name is string
          && d.name != ''
          && d.name.size() <= 120
          && d.date is string
          && d.date != ''
          && d.amountPaise is int
          && d.amountPaise > 0
          && n > 0
          && d.committeeSharePaise is int
          && d.committeeSharePaise == d.amountPaise / 10
          && pool > 0
          && pool == d.amountPaise - d.committeeSharePaise
          && d.allocations is map
          && d.allocations.size() == n
          && d.allocations.values().hasOnly([base, base + 1]);
      }

      // The credit batch must carry the committee update that references
      // exactly this job, and the FINAL committee state (atomic write,
      // getAfter) must have grown by exactly the committee share.
      function jobCreditBatchOk(d) {
        let c = request.writes.get('meta/committee', null);
        let cOld = committeeOld();
        let cNew = committeeNew();
        return c != null
          && c.method == 'update'
          && c.resource.data.lastJobId == jobId
          && cOld != null
          && cNew != null
          && cNew.balancePaise is int
          && cNew.balancePaise >= 0
          && cNew.balancePaise - paiseOf(cOld) == d.committeeSharePaise;
      }

      allow create: if isAdmin()
        && jobShapeOk(request.resource.data)
        && jobCreditBatchOk(request.resource.data);

      // Status flag toggling (active/archived) — the only plain update.
      function statusToggleOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
          && request.resource.data.status in ['active', 'archived'];
      }

      // Reversal = tombstone (status 'reversed' + reversedAt), never a
      // delete: the original allocation history stays readable for audit.
      // The batch must credit the committee back by exactly the ORIGINAL
      // committee share (final state via getAfter).
      function reversalJobOk() {
        let c = request.writes.get('meta/committee', null);
        let cOld = committeeOld();
        let cNew = committeeNew();
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.allocations is map
          && resource.data.allocations.size() > 0
          && resource.data.committeeSharePaise is int
          && resource.data.status != 'reversed'
          && request.resource.data.status == 'reversed'
          && changed.hasOnly(['status', 'reversedAt'])
          && c != null
          && c.method == 'update'
          && c.resource.data.reversedJobId == jobId
          && cOld != null
          && cNew != null
          && cNew.balancePaise is int
          && cNew.balancePaise >= 0
          && paiseOf(cOld) - cNew.balancePaise == resource.data.committeeSharePaise;
      }

      allow update: if isAdmin() && (statusToggleOk() || reversalJobOk());

      // Jobs are never deleted (audit history). Use the reversal tombstone.
      allow delete: if false;
    }

    /* --------------------------- /meta/committee ------------------------ */

    match /meta/committee {
      // The committee balance is shown to all signed-in users (public fund).
      allow get: if signedIn();
      allow list: if false;

      // Bootstrap at zero only (idempotent app init).
      allow create: if signedIn()
        && request.resource.data.balancePaise == 0
        && request.resource.data.balance == 0
        && request.resource.data.keys().hasOnly(['balancePaise', 'balance']);

      // Real changes only inside a job batch, by an admin. The job write
      // must be present at the exact key the committee doc references.
      // (The amount deltas are validated by the /jobs rules via getAfter.)
      function inCreditBatch() {
        let c = request.resource.data;
        let jid = c.lastJobId is string ? c.lastJobId : null;
        let jw = jid == null ? null : request.writes.get('jobs/' + jid, null);
        return jid != null
          && jid != ''
          && jw != null
          && jw.method == 'set';
      }

      function inReversalBatch() {
        let c = request.resource.data;
        let jid = c.reversedJobId is string ? c.reversedJobId : null;
        let jw = jid == null ? null : request.writes.get('jobs/' + jid, null);
        return jid != null
          && jid != ''
          && jw != null
          && jw.method == 'update';
      }

      allow update: if isAdmin() && (inCreditBatch() || inReversalBatch());

      allow delete: if false;
    }

    /* -------------------- legacy /transactions (audit) ------------------ */

    // Pre-v3.1 top-level transaction collection. Reads are admin-only
    // (audit); writes are hard-denied so the historical ledger is immutable.
    match /transactions/{txnId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Explicit deny for everything not covered above (no catch-alls).
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
